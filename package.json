{
  "name": "patience-garden",
  "version": "1.0.0",
  "description": "Patience Garden — a botanical glasshouse solitaire on the StarHermit engine.",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run test:unit && npm run test:native",
    "test:unit": "node --test tests/rules.test.mjs tests/save.test.mjs tests/save-merge.test.mjs tests/i18n.test.mjs",
